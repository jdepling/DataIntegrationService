@model List<Integration.Admin.Models.FailedMessageViewModel>

@{
    ViewData["Title"] = "Failed Messages";
}

<h1>Failed Messages</h1>

<table class="table">
    <thead>
        <tr>
            <th>Source ID</th>
            <th>Error</th>
            <th>Failure Type</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var message in Model)
        {
            <tr>
                <td>@message.SourceId</td>
                <td>@message.ErrorMessage</td>
                <td>@message.FailureType</td>
                <td>@message.CreatedAt.ToLocalTime()</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@message.Id"
                       class="btn btn-secondary">
                        Details
                    </a>
                    <form asp-action="Replay" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@message.Id" />
                        <button type="submit" class="btn btn-primary">
                            Replay
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>