@model List<Integration.Admin.Models.FailedMessageViewModel>
@using Integration.Data

@{
    ViewData["Title"] = "Failed Messages";
}

<div class="mb-4">
    <h1 class="mb-1">Failed Messages</h1>
    <p class="text-muted mb-0">
        Monitor, investigate, and replay failed integration messages.
    </p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>Source ID</th>
            <th>Error</th>
            <th>Failure Type</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var message in Model)
        {
            <tr>
                <td>@message.SourceId</td>
                <td>
                    <span class="error-message" title="@message.ErrorMessage">
                        @message.ErrorMessage
                    </span>
                </td>
                <td>
                    @if (message.FailureType == FailureType.Transient)
                    {
                        <span class="badge bg-warning text-dark">Transient</span>
                    }
                    else if (message.FailureType == FailureType.Permanent)
                    {
                        <span class="badge bg-danger">Permanent</span>
                    }
                </td>
                <td>@message.CreatedAt.ToLocalTime()</td>
                <td class="text-nowrap">
                    <a asp-action="Details"
                       asp-route-id="@message.Id"
                       class="btn btn-secondary">
                        Details
                    </a>
                    <form asp-action="Replay" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@message.Id" />
                        <button type="submit" class="btn btn-primary">
                            Replay
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>